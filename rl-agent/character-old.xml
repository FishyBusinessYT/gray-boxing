<mujoco model="mi_personaje">
  <include file="./suite/common/skybox.xml"/>
  <include file="./suite/common/visual.xml"/>
  <include file="./suite/common/materials.xml"/>
  <compiler meshdir="../assets/exports" angle="degree"/>

  <asset>
    <mesh name="torso"        file="Torso/Torso.obj"/>
    <mesh name="head"         file="Head/Head.obj"/>
    <mesh name="upper_arm_l"  file="LUpperArm/LUpperArm.obj"/>
    <mesh name="lower_arm_l"  file="LForearm/LForearm.obj"/>
    <mesh name="upper_arm_r"  file="RUpperArm/RUpperArm.obj"/>
    <mesh name="lower_arm_r"  file="RForearm/RForearm.obj"/>
    <mesh name="upper_leg_l"  file="LThigh/LThigh.obj"/>
    <mesh name="lower_leg_l"  file="LShin/LShin.obj"/>
    <mesh name="foot_l"       file="LFoot/LFoot.obj"/>
    <mesh name="upper_leg_r"  file="RThigh/RThigh.obj"/>
    <mesh name="lower_leg_r"  file="RShin/RShin.obj"/>
    <mesh name="foot_r"       file="RFoot/RFoot.obj"/>
  </asset>

  <worldbody>
    <geom name="floor" pos="0 0 0" size="0 0 .05" type="plane" material="grid"/>

    <!-- Root: torso flotante con freejoint para RL -->
    <body name="torso" pos="0 0 1.3" euler="90 0 0">
      <freejoint name="root"/>
      <geom type="mesh" mesh="torso"/>

      <!-- Cabeza - Corregido range de ball joint -->
      <body name="head" pos="0 0 0.25">
        <joint name="neck" type="ball" range="0 40"/>
        <geom type="mesh" mesh="head"/>
      </body>

      <!-- Brazo izquierdo - Corregido range de ball joint -->
      <body name="upper_arm_l" pos="0.2 0 0.1">
        <joint name="shoulder_l" type="ball" range="0 85"/>
        <geom type="mesh" mesh="upper_arm_l"/>

        <body name="lower_arm_l" pos="0 0 -0.25">
          <joint name="elbow_l" type="hinge" axis="0 1 0" range="-5 145"/>
          <geom type="mesh" mesh="lower_arm_l"/>
        </body>
      </body>

      <!-- Brazo derecho - Corregido range de ball joint -->
      <body name="upper_arm_r" pos="-0.2 0 0.1">
        <joint name="shoulder_r" type="ball" range="0 85"/>
        <geom type="mesh" mesh="upper_arm_r"/>

        <body name="lower_arm_r" pos="0 0 -0.25">
          <joint name="elbow_r" type="hinge" axis="0 1 0" range="-5 145"/>
          <geom type="mesh" mesh="lower_arm_r"/>
        </body>
      </body>

      <!-- Pierna izquierda - Corregido range de ball joint -->
      <body name="upper_leg_l" pos="0.1 0 -0.2">
        <joint name="hip_l" type="ball" range="0 90"/>
        <geom type="mesh" mesh="upper_leg_l"/>

        <body name="lower_leg_l" pos="0 0 -0.3">
          <joint name="knee_l" type="hinge" axis="0 1 0" range="-5 130"/>
          <geom type="mesh" mesh="lower_leg_l"/>

          <body name="foot_l" pos="0 0 -0.25">
            <joint name="ankle_l" type="hinge" axis="0 1 0" range="-50 60"/>
            <geom type="mesh" mesh="foot_l"/>
          </body>
        </body>
      </body>

      <!-- Pierna derecho - Corregido range de ball joint -->
      <body name="upper_leg_r" pos="-0.1 0 -0.2">
        <joint name="hip_r" type="ball" range="0 90"/>
        <geom type="mesh" mesh="upper_leg_r"/>

        <body name="lower_leg_r" pos="0 0 -0.3">
          <joint name="knee_r" type="hinge" axis="0 1 0" range="-5 130"/>
          <geom type="mesh" mesh="lower_leg_r"/>

          <body name="foot_r" pos="0 0 -0.25">
            <joint name="ankle_r" type="hinge" axis="0 1 0" range="-50 60"/>
            <geom type="mesh" mesh="foot_r"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- Actuadores para RL -->
  <actuator>
    <motor name="neck"        joint="neck"      gear="10"/>
    <motor name="shoulder_l" joint="shoulder_l" gear="50"/>
    <motor name="elbow_l"    joint="elbow_l"   gear="30"/>
    <motor name="shoulder_r" joint="shoulder_r" gear="50"/>
    <motor name="elbow_r"    joint="elbow_r"   gear="30"/>
    <motor name="hip_l"      joint="hip_l"     gear="80"/>
    <motor name="knee_l"     joint="knee_l"    gear="60"/>
    <motor name="ankle_l"    joint="ankle_l"   gear="30"/>
    <motor name="hip_r"      joint="hip_r"     gear="80"/>
    <motor name="knee_r"     joint="knee_r"    gear="60"/>
    <motor name="ankle_r"    joint="ankle_r"   gear="30"/>
  </actuator>

</mujoco>