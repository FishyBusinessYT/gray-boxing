<mujoco model="humanoid-openai-based">
    <include file="./commons/skybox.xml"/>
    <include file="./commons/visual.xml"/>
    <include file="./commons/materials.xml"/>

    <default>
        <joint armature="1" damping="1" limited="true"/>
        <geom conaffinity="1" condim="1" contype="1" margin="0.001" rgba="0.8 0.6 .4 1"/>
        <motor ctrllimited="true" ctrlrange="-.4 .4"/>
    </default>

    <worldbody>
        <geom name="floor" pos="0 0 0" size="0 0 .05" type="plane" material="grid" friction="1 0.005 0.0001" rgba="0 0 0 1"/>
        <geom name="ring_floor" pos="0 0 0.1" size="1.6 1.6 0.1" type="box" rgba="0.5 0.5 0.5 1" friction="1 1 1"/>

        <body name="pole_bottom_left" pos="-1.5 -1.5 0.1">
            <geom type="cylinder" size="0.1 0.7" pos="0 0 0.7" rgba="1 1 0.5 1" contype="2" conaffinity="1"/>

            <site name="bl-tl-1" pos="0 0.1 1.3"/>
            <site name="bl-tl-2" pos="0 0.1 0.9"/>
            <site name="bl-tl-3" pos="0 0.1 0.5"/>

            <site name="bl-br-1" pos="0.1 0 1.3"/>
            <site name="bl-br-2" pos="0.1 0 0.9"/>
            <site name="bl-br-3" pos="0.1 0 0.5"/>
        </body>
        <body name="pole_top_left" pos="-1.5 1.5 0.1">
            <geom type="cylinder" size="0.1 0.7" pos="0 0 0.7" rgba="1 0.5 0.5 1" contype="2" conaffinity="1"/>

            <site name="tl-bl-1" pos="0 -0.1 1.3"/>
            <site name="tl-bl-2" pos="0 -0.1 0.9"/>
            <site name="tl-bl-3" pos="0 -0.1 0.5"/>

            <site name="tl-tr-1" pos="0.1 0 1.3"/>
            <site name="tl-tr-2" pos="0.1 0 0.9"/>
            <site name="tl-tr-3" pos="0.1 0 0.5"/>
        </body>
        <body name="pole_bottom_right" pos="1.5 -1.5 0.1">
            <geom type="cylinder" size="0.1 0.7" pos="0 0 0.7" rgba="1 0.5 0.5 1" contype="2" conaffinity="1"/>

            <site name="br-bl-1" pos="-0.1 0 1.3"/>
            <site name="br-bl-2" pos="-0.1 0 0.9"/>
            <site name="br-bl-3" pos="-0.1 0 0.5"/>

            <site name="br-tr-1" pos="0 0.1 1.3"/>
            <site name="br-tr-2" pos="0 0.1 0.9"/>
            <site name="br-tr-3" pos="0 0.1 0.5"/>
        </body>
        <body name="pole_top_right" pos="1.5 1.5 0.1">
            <geom type="cylinder" size="0.1 0.7" pos="0 0 0.7" rgba="1 0.5 0.5 1" contype="2" conaffinity="1"/>

            <site name="tr-tl-1" pos="-0.1 0 1.3"/>
            <site name="tr-tl-2" pos="-0.1 0 0.9"/>
            <site name="tr-tl-3" pos="-0.1 0 0.5"/>

            <site name="tr-br-1" pos="0 -0.1 1.3"/>
            <site name="tr-br-2" pos="0 -0.1 0.9"/>
            <site name="tr-br-3" pos="0 -0.1 0.5"/>
        </body>
    </worldbody>
</mujoco>